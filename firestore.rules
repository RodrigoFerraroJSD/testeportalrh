rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified() { return request.auth != null && request.auth.token.email_verified == true; }
  function staff() { return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
  function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
  function admin() { return staff() && role() == 'admin'; }
  function manager() { return staff() && role() in ['admin','rh']; }
  function valid() {
   let d = request.resource.data;
   return d.keys().hasOnly(['name','email','department','title','role','status','initials']) && d.keys().hasAll(['name','email','department','title','role','status','initials'])
   && d.name is string && d.name.size() > 0 && d.name.size() <= 150
   && d.email is string && d.email.size() > 0 && d.email.size() <= 254
   && d.department is string && d.department.size() > 0 && d.department.size() <= 150
   && d.title is string && d.title.size() > 0 && d.title.size() <= 150
   && d.role in ['Colaborador','RH','Administrador'] && d.status in ['Ativo','Pendente','Inativo']
   && d.initials is string && d.initials.size() <= 10;
  }
  match /users/{uid} {
   allow get: if verified() && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /employees/{id} {
   allow read: if manager();
   allow create: if manager() && valid() && (admin() || request.resource.data.role == 'Colaborador');
   allow update: if manager() && valid() && request.resource.data.email == resource.data.email && (admin() || (resource.data.role == 'Colaborador' && request.resource.data.role == 'Colaborador'));
   allow delete: if admin();
  }
 }
}