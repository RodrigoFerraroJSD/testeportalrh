rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /demoUsers/{uid}/employees/{id} {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['name','email','department','title','role','status','initials'])
    && request.resource.data.keys().hasAll(['name','email','department','title','role','status','initials'])
    && request.resource.data.name is string && request.resource.data.name.size() <= 150
    && request.resource.data.email is string && request.resource.data.email.size() <= 254
    && request.resource.data.department is string && request.resource.data.department.size() <= 150
    && request.resource.data.title is string && request.resource.data.title.size() <= 150
    && request.resource.data.role in ['Colaborador','RH','Administrador']
    && request.resource.data.status in ['Ativo','Pendente','Inativo']
    && request.resource.data.initials is string && request.resource.data.initials.size() <= 10;
  }
 }
}
